{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.claude.json)",
      "Read(~/.config/opencode/service.json)",
      "Read(*.env)",
      "Read(**/.env)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.kube/**)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(brew *)",
      "Bash(apt *)",
      "Bash(dnf *)",
      "Bash(uv tool *)",
      "Bash(direnv allow *)",
      "Bash(git push --force *)",
      "Bash(kubectl delete *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(ls *)"
    ]
  }
}
