#!/usr/bin/env bash
# Add GDScript (.gd) support to the graphify installed on this machine.
#
# graphify ships tree-sitter extractors for ~40 languages but not GDScript, so
# every Godot project's scripts are invisible to its knowledge graph. graphify
# is installed once per machine and each repo builds its own graph, so the
# patch is machine-level: run this once after installing graphify and again
# after every graphify upgrade (an upgrade replaces the patched files).
#
#   graphify-gdscript                 patch the graphify on PATH (idempotent)
#   graphify-gdscript --check         exit 0 if patched, 1 if not; change nothing
#   graphify-gdscript --python PATH   patch the graphify installed for PATH
#
# What it does, in graphify's own environment:
#   1. installs `tree-sitter-language-pack` (bundles the gdscript grammar),
#      with pip, or `uv pip` where the environment has no pip (a uv tool);
#   2. writes a `tree_sitter_gdscript` shim exposing the grammar as language();
#   3. patches graphify/detect.py: `.gd` in CODE_EXTENSIONS;
#   4. patches graphify/extract.py: a GDScript LanguageConfig + dispatch entry;
#   5. patches graphify/extractors/engine.py: a positional-callee branch
#      (GDScript calls have no named callee field) and a fix so a provider
#      that returns a Language (not a capsule) works.
# Each step is written as soon as it succeeds, so a later anchor mismatch
# can't drop an earlier one. Ends by parsing a GDScript snippet.
#
# The entry point is bash on purpose: it finds `graphify` on PATH exactly as
# your shell does (a Python entry point launched through a pyenv shim sees
# pyenv's bin/ first and would pick another install), reads the interpreter
# from its shebang, and runs the Python below under it.
#
# Moved here from godot-mcp (scripts/graphify_gdscript_support.py) so every
# project shares one copy; system/install.sh installs it to ~/.local/bin.
set -euo pipefail

py=""
args=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --python) py=${2:?--python needs a path}; shift 2 ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) args+=("$1"); shift ;;
  esac
done

if [[ -z $py ]]; then
  exe=$(command -v graphify) || { echo "graphify-gdscript: graphify is not on PATH" >&2; exit 1; }
  # The interpreter graphify runs on: its shebang, or the `exec` line of the
  # /bin/sh trampoline uv writes when the path is long or has spaces.
  line2=""
  { IFS= read -r line1; IFS= read -r line2 || true; } < "$exe"
  if [[ $line1 == '#!/bin/sh' && $line2 == *exec* ]]; then
    py=$(printf '%s\n' "$line2" | sed -n "s/^'''exec' \"\{0,1\}\([^\" ]*\).*/\1/p")
  elif [[ $line1 == '#!'* ]]; then
    read -r -a parts <<<"${line1#\#!}"
    [[ ${parts[0]} == */env ]] && parts=("${parts[@]:1}")
    py=${parts[0]:-}
  fi
  [[ -n $py ]] || { echo "graphify-gdscript: can't tell which Python $exe runs on; pass --python" >&2; exit 1; }
fi

exec "$py" -I - ${args[@]+"${args[@]}"} <<'PY'
from __future__ import annotations

import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

PACK = "tree-sitter-language-pack>=1.8"
SNIPPET = "extends Node\n\nfunc _ready() -> void:\n\tprint(_helper())\n\nfunc _helper() -> int:\n\treturn 1\n"


def _ensure_language_pack() -> None:
    try:
        import tree_sitter_language_pack  # noqa: F401
        return
    except ImportError:
        pass
    print("installing tree-sitter-language-pack …")
    has_pip = subprocess.run([sys.executable, "-m", "pip", "--version"],
                             capture_output=True, check=False).returncode == 0
    if has_pip:
        cmd = [sys.executable, "-m", "pip", "install", "-q", PACK]
    elif shutil.which("uv"):
        cmd = ["uv", "pip", "install", "-q", "--python", sys.executable, PACK]
    else:
        raise SystemExit("no pip in graphify's environment and no uv on PATH: "
                         f"install {PACK!r} into {sys.executable}")
    subprocess.run(cmd, check=True)


def _write_shim(site_dir: Path) -> None:
    shim = site_dir / "tree_sitter_gdscript.py"
    body = (
        '"""Shim: expose the language-pack GDScript grammar as a standalone\n'
        'tree_sitter_gdscript module so graphify\'s ts_module config can load it."""\n'
        "from tree_sitter_language_pack import get_language\n\n\n"
        "def language():\n"
        '    """Return the GDScript tree_sitter.Language (graphify wraps it)."""\n'
        '    return get_language("gdscript")\n'
    )
    if shim.exists() and shim.read_text() == body:
        print(f"shim already current: {shim}")
        return
    shim.write_text(body)
    print(f"wrote shim: {shim}")


def _patch_detect(detect_py: Path) -> None:
    src = detect_py.read_text()
    if "'.gd'" in src.split("CODE_EXTENSIONS")[1].split("}")[0]:
        print("detect.py: .gd already in CODE_EXTENSIONS")
        return
    anchor = "CODE_EXTENSIONS = {'.py',"
    if anchor not in src:
        raise SystemExit("detect.py: CODE_EXTENSIONS anchor not found — graphify layout changed")
    detect_py.write_text(src.replace(anchor, "CODE_EXTENSIONS = {'.gd', '.py',", 1))
    print("detect.py: added '.gd' to CODE_EXTENSIONS")


_CONFIG_BLOCK = '''_GDSCRIPT_CONFIG = LanguageConfig(
    ts_module="tree_sitter_gdscript",
    ts_language_fn="language",
    class_types=frozenset({"class_definition"}),
    function_types=frozenset({"function_definition", "constructor_definition"}),
    import_types=frozenset(),
    call_types=frozenset({"call", "attribute_call"}),
    call_function_field="",
    name_field="name",
    name_fallback_child_types=("name", "identifier"),
    body_field="body",
    body_fallback_child_types=("body",),
    function_boundary_types=frozenset(
        {"function_definition", "constructor_definition", "class_definition"}
    ),
)


def extract_gdscript(path: Path) -> dict:
    """Extract classes, functions, and calls from a .gd (GDScript) file."""
    return _extract_generic(path, _GDSCRIPT_CONFIG)


'''

_CALL_BRANCH = '''            elif config.ts_module == "tree_sitter_gdscript":
                # GDScript: callee is the first identifier child (positional, no
                # named field) for both `call` and `attribute_call`.
                _gd_first = node.children[0] if node.children else None
                if _gd_first is not None and _gd_first.type == "identifier":
                    callee_name = _read_text(_gd_first, source)
'''


def _patch_extract(extract_py: Path) -> None:
    # The LanguageConfig / dispatch tables live in extract.py (v0.9.56 layout).
    src = extract_py.read_text()
    if "_GDSCRIPT_CONFIG" not in src:
        anchor = "def extract_lua(path: Path) -> dict:"
        if anchor not in src:
            raise SystemExit("extract.py: extract_lua anchor not found — graphify layout changed")
        src = src.replace(anchor, _CONFIG_BLOCK + anchor, 1)
        extract_py.write_text(src)
        print("extract.py: added _GDSCRIPT_CONFIG + extract_gdscript")
    else:
        print("extract.py: _GDSCRIPT_CONFIG already present")
    if '".gd": extract_gdscript' not in src:
        anchor = '    ".lua": extract_lua,\n'
        if anchor not in src:
            raise SystemExit("extract.py: _DISPATCH lua anchor not found — graphify layout changed")
        src = src.replace(anchor, anchor + '    ".gd": extract_gdscript,\n', 1)
        extract_py.write_text(src)
        print("extract.py: registered .gd in _DISPATCH")
    else:
        print("extract.py: .gd already in _DISPATCH")


def _patch_engine(engine_py: Path) -> None:
    # The generic extractor engine (the Language() wrap + the call handler).
    src = engine_py.read_text()
    if "_raw_lang = lang_fn()" not in src:
        anchor = "        language = Language(lang_fn())\n"
        if anchor not in src:
            raise SystemExit("engine.py: Language(lang_fn()) anchor not found — graphify layout changed")
        src = src.replace(anchor, (
            "        _raw_lang = lang_fn()\n"
            "        language = _raw_lang if isinstance(_raw_lang, Language) "
            "else Language(_raw_lang)\n"
        ), 1)
        engine_py.write_text(src)
        print("engine.py: made Language() robust to Language-returning providers")
    else:
        print("engine.py: Language-wrap fix already present")
    if "# GDScript: callee is the first identifier child" not in src:
        # Anchored on the `else:` and the start of its comment only: graphify
        # 0.9.95 joined the comment's two lines into one.
        anchor = ("            else:\n"
                  "                # Generic: get callee from call_function_field")
        if src.count(anchor) != 1:
            raise SystemExit("engine.py: generic call-handler anchor not found — graphify layout changed")
        engine_py.write_text(src.replace(anchor, _CALL_BRANCH + anchor, 1))
        print("engine.py: added GDScript positional-callee branch")
    else:
        print("engine.py: GDScript call branch already present")


def _verify() -> bool:
    """Parse a GDScript snippet: two functions and the call between them."""
    try:
        from graphify.extract import _DISPATCH
    except Exception:  # noqa: BLE001 - any import failure means unpatched
        return False
    if ".gd" not in _DISPATCH:
        return False
    with tempfile.TemporaryDirectory() as tmp:
        path = Path(tmp) / "probe.gd"
        path.write_text(SNIPPET)
        try:
            result = _DISPATCH[".gd"](path)
        except Exception:  # noqa: BLE001
            return False
    labels = " ".join(str(n.get("label", "")) for n in result.get("nodes", []))
    return "_ready" in labels and "_helper" in labels and bool(result.get("edges"))


def main(argv: list[str]) -> int:
    try:
        import graphify
    except ImportError:
        print(f"graphify-gdscript: graphify is not importable by {sys.executable}; "
              "pass --python <the interpreter graphify runs on>", file=sys.stderr)
        return 1
    gdir = Path(graphify.__file__).parent
    if "--check" in argv:
        ok = _verify()
        print(f"graphify at {gdir}: GDScript {'supported' if ok else 'NOT patched'}")
        return 0 if ok else 1
    print(f"graphify: {gdir}")
    _ensure_language_pack()
    _write_shim(gdir.parent)
    _patch_detect(gdir / "detect.py")
    _patch_extract(gdir / "extract.py")
    _patch_engine(gdir / "extractors" / "engine.py")
    if not _verify():
        print("GDScript probe failed: the patch applied but a .gd snippet did not parse",
              file=sys.stderr)
        return 1
    print("GDScript support OK")
    return 0


sys.exit(main(sys.argv[1:]))
PY
