{
  "version": "1.0.0",
  "description": "Deterministic runtime policy for GitHub Copilot tool use. Copilot hooks evaluate this JSON before allowing file edits, shell commands, and refactors.",
  "policies": {
    "file_edit": {
      "max_lines_changed": 150,
      "require_tests_for_logic": true,
      "forbid_patterns": [
        "time.sleep\\(",
        "print\\(",
        "except Exception:",
        "import os\\n",
        "SECRET_KEY\\s*=\\s*['\"]",
        "DATABASE_URL\\s*=\\s*['\"]",
        "\\bdb\\.commit\\b",
        "asyncio\\.sleep"
      ],
      "required_comment_patterns": [
        "# Article (I|II|III|IV|V|VI|VII|VIII|IX): .*",
        "TODO|FIXME|HACK"
      ],
      "allow_globals_modification": false
    },
    "shell_command": {
      "allowed_prefixes": [
        "uv run", "npm run", "pytest", "vitest", "ruff", "mypy",
        "git status", "git diff", "git log", "git checkout",
        "docker compose", "supabase", "npx"
      ],
      "forbidden_prefixes": [
        "curl ", "wget ", "docker build", "docker rm -f -v",
        "sudo", "rm -rf /", "shutdown", "reboot", "dd if=",
        "eval\\b", "exec\\b"
      ],
      "max_duration_seconds": 120
    },
    "refactor": {
      "require_approval_for": ["rename_class", "move_file", "delete_file"],
      "max_files_per_refactor": 10,
      "require_passing_tests_after": true,
      "forbid_patterns": ["raw SQL in route handler", "dict\\[str, Any\\]"]
    },
    "security": {
      "require_secret_scan_for_file_extensions": [".env", ".key", ".pem", ".p12"],
      "block_hardcoded_tokens": true,
      "require_https_for_urls": true
    }
  },
  "violations": {
    "policy_violation": "log_and_warn",
    "security_violation": "block_and_notify"
  }
}
