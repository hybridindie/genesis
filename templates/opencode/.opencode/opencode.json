{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["my-workflows.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "brew *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "ask" },
    { "action": "shell", "resource": "direnv allow *", "effect": "ask" },
    { "action": "read", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/**", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/**", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" }
  ]
}
